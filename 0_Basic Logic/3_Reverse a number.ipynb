     "text": [
      "1221\n",
      "palindrom\n"
     ]
    }
   ],
   "source": [
    "n = 1221\n",
    "original = n\n",
    "reversed = 0\n",
    "\n",
    "while original > 0:\n",
    "    digit= original % 10\n",
    "    reversed = reversed * 10 + digit\n",
    "    original = original // 10\n",
    "\n",
    "print(reversed)\n",
    "\n",
    "if n == reversed:\n",
    "    print(\"palindrom\")\n",
    "else:\n",
    "    print(\"Not palindrom\")"
   ]
  }
